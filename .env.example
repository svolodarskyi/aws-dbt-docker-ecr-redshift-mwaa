# AWS Configuration
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
AWS_PROFILE=data-platform-dev

# Project Configuration
PROJECT_NAME=data-platform
ENVIRONMENT=dev

# Redshift (Dev)
REDSHIFT_HOST_DEV=dev-cluster.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_USER_DEV=dbt_dev_user
REDSHIFT_PASSWORD_DEV=CHANGE_ME_USE_SECRETS_MANAGER
REDSHIFT_DATABASE_DEV=analytics_dev
REDSHIFT_SCHEMA_DEV=dbt_dev

# Redshift (Prod) - Use AWS Secrets Manager in production
REDSHIFT_HOST_PROD=prod-cluster.redshift.amazonaws.com
REDSHIFT_USER_PROD=dbt_prod_user
REDSHIFT_PASSWORD_PROD=USE_SECRETS_MANAGER
REDSHIFT_DATABASE_PROD=analytics_prod
REDSHIFT_SCHEMA_PROD=analytics

# dbt Configuration
DBT_TARGET=dev
DBT_PROFILES_DIR=./dbt/profiles
DBT_THREADS=4

# S3 Buckets
S3_RAW_DATA_BUCKET=data-platform-raw-data-dev
S3_MWAA_BUCKET=data-platform-mwaa-dev
S3_DBT_ARTIFACTS_BUCKET=data-platform-dbt-artifacts-dev
S3_TERRAFORM_STATE_BUCKET=data-platform-terraform-state

# ECS/Docker
ECR_REPOSITORY=data-platform-dbt
ECS_CLUSTER=dbt-cluster
ECS_TASK_DEFINITION=dbt-transformation-task

# MWAA
MWAA_ENVIRONMENT_NAME=data-platform-airflow-dev

# Monitoring
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:data-pipeline-alerts-dev

# Local Development
LOCAL_DATA_DIR=/tmp/data-platform
